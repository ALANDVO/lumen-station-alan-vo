# Lumen Station Environment Configuration

# Server
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEMO_MODE=true
SECRET_KEY=

# Storage
DATABASE_PATH=lumen_station.db

# Authentication (OIDC / Keycloak)
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=lumen-station
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback

# Opt-in LLM Provider (Optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Sandboxing & Watchdog Defaults
DEFAULT_EXECUTION_TIMEOUT=30
MAX_CHUNK_BYTES=65536
MAX_OUTPUT_BYTES=5242880
